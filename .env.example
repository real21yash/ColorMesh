# ColorMesh runs entirely in the browser — no API keys, database
# credentials, or secrets of any kind are required to run it locally.
#
# The variables below are optional and only affect SEO metadata
# (Open Graph tags, canonical URL, sitemap references). Safe to leave
# unset for local development.

# Public URL where the app is deployed. Used to build canonical/Open
# Graph URLs. Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console site-verification code.
# Leave unset unless you're verifying ownership of a deployed domain.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
